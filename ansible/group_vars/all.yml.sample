---
# TEMPLATE. Copy to group_vars/all.yml, which is untracked, and edit that:
#
#     cp group_vars/all.yml.sample group_vars/all.yml
#
# What each variable does, and why it is set this way: ./all.README.md
# Deeper detail on any default: the owning roles/*/defaults/main.yml
#
#   !! THIS FILE IS COMMITTED TO A PUBLIC REPO. NEVER PUT A REAL TOKEN, KEY
#      OR PASSWORD IN IT. The empty strings below are empty on purpose. !!
#
# Keep this file free of prose: the gpu_machinesets block is rewritten by
# run.sh with an awk that treats a '#' at column 0 as the end of the list.
# When you add a variable here, document it in all.README.md.

# --- Cluster context -------------------------------------------------------
ocp_context: ""
ocp_expected_api: ""
ocp_context_arg: >-
  {{ ('--context ' ~ (ocp_context | quote)) if ocp_context | length > 0 else '' }}

# --- GPU workers -----------------------------------------------------------
gpu_availability_zone: ""
gpu_volume_size: 120
gpu_machinesets:
- instance_type: g4dn.4xlarge
  replicas: 0
- instance_type: g6e.4xlarge
  replicas: 1
- instance_type: g6e.12xlarge
  replicas: 0
- instance_type: g6.12xlarge
  replicas: 0
- instance_type: g5.12xlarge
  replicas: 0
- instance_type: g7e.2xlarge
  replicas: 0
- instance_type: g7e.4xlarge
  replicas: 0
- instance_type: g7e.8xlarge
  replicas: 0
- instance_type: g7e.12xlarge
  replicas: 0
- instance_type: g7e.24xlarge
  replicas: 0
- instance_type: p4d.24xlarge
  replicas: 0
- instance_type: p4de.24xlarge
  replicas: 0

# --- Model serving ---------------------------------------------------------
# qwen3-4b | qwen3-8b | qwen3-14b | qwen3.8-27b | qwen3.8-27b-fp8
model_preset: qwen3-4b
hf_token: ""

# --- Console ---------------------------------------------------------------
console_plugins:
- pipelines-console-plugin
- gitops-plugin
- kuadrant-console-plugin
- odf-console
- odf-client-console

# --- Quay ------------------------------------------------------------------
deploy_quay_registry: true
# Only when ODF is not available:
#quay_s3_bucket: ""
#quay_s3_region: ""
#quay_s3_access_key: ""
#quay_s3_secret_key: ""

# --- Operations dashboard --------------------------------------------------
dashboard_aws_access_key_id: ""
dashboard_aws_secret_access_key: ""

# --- MCP server ------------------------------------------------------------
mcp_write_rules:
- apiGroups: [ "" ]
  resources: [ pods, pods/log, services, configmaps, persistentvolumeclaims ]
  verbs: [ get, list, watch, create, update, patch, delete ]
- apiGroups: [ "apps" ]
  resources:
  - deployments
  - deployments/scale
  - statefulsets
  - statefulsets/scale
  - daemonsets
  - replicasets
  verbs: [ get, list, watch, create, update, patch, delete ]
- apiGroups: [ "batch" ]
  resources: [ jobs, cronjobs ]
  verbs: [ get, list, watch, create, update, patch, delete ]
- apiGroups: [ "route.openshift.io" ]
  resources: [ routes ]
  verbs: [ get, list, watch, create, update, patch, delete ]

# --- OpenRAG ---------------------------------------------------------------
deploy_openrag: true
openrag_auto_configure: true

# --- Milvus ----------------------------------------------------------------
deploy_milvus: true

# --- Omnigent --------------------------------------------------------------
deploy_omnigent: true
omnigent_sandboxes: true
omnigent_version: v0.18.0
# kubernetes | openshell. openshell sandboxes each agent session with
# Landlock on the filesystem, seccomp on syscalls and a deny-by-default
# egress proxy; it needs deploy_openshell below. kubernetes is the default
# because it has no kernel prerequisite and no extra images to pull.
omnigent_sandbox_provider: kubernetes

# true  = oauth-proxy, log in with your OpenShift identity.
# false = Omnigent's own accounts; the admin password is generated on first
#         run into the omnigent-admin Secret and shown on the Ops Dashboard.
#
# MUST be false whenever omnigent_sandboxes is true. Header/proxy auth
# cannot mint the bearer a managed sandbox's runner needs, so every session
# reaches "host online" and then fails its first callback with HTTP 401,
# surfacing as "Native <harness> terminal failed to start". The role refuses
# the combination rather than letting you find that out from a crash loop.
omnigent_auth: true

# --- Gen AI playground -----------------------------------------------------
# Correct the playground's llama-stack config. On by default: without it the
# AI asset endpoints are ignored, no model carries a credential, and AutoRAG
# fails on model enumeration.
deploy_genai_playground: true

# --- OpenShell -------------------------------------------------------------
# Only used when omnigent_sandbox_provider is openshell.
#
# The role checks the kernel's Landlock ABI before installing anything and
# refuses below ABI 2. Worth knowing because the headline prerequisite is
# widely misreported: Landlock ABI 2 landed in mainline 5.19 and RHCOS 9 is
# on 5.14, which reads like OpenShift needs an irreversible MultiOS
# migration to RHCOS 10. It does not - Red Hat backported Landlock, and
# RHCOS 9.8 on OCP 4.22 measures ABI 6, the mainline 6.12 feature level.
# The role asks the kernel rather than the version string.
deploy_openshell: false

# ===========================================================================
# OPTIONAL - nothing below here is necessary.
# ===========================================================================

# --- Zero Trust Workload Identity Manager ----------------------------------
deploy_ztwim: false

# --- External DNS / Cloudflare ---------------------------------------------
deploy_external_dns: false
external_dns_domain: kubernetes.day
cloudflare_api_token: ""
external_dns_cloudflare_proxied: true
#dashboard_custom_host: ""
#devspaces_custom_host: ""

# --- Extra model endpoints -------------------------------------------------
# Never commit an api_key. Supply at run time instead:
#   ./run.sh --tags litellm -e @$HOME/.openshift-ai-endpoints.yml
#litellm_extra_models:
#- name: maas-rhdp
#  credential_name: rhdp-maas
#  base_url: https://maas-rhdp.apps.maas.redhatworkshops.io/v1
#  api_key: ""
#  models:
#  - gpt-oss-120b
#  - qwen36-35b-a3b
#  - qwen38-27b
#  - granite-3-2-8b-instruct
#  - Docling

# --- Demos -----------------------------------------------------------------
deploy_demos: true
demos_rag_eval: true
demos_rag_judge: true
demos_prompt_versions: true
demos_tabular: true
demos_model_serving: true
demos_autorag: true
demos_workbenches: true
demos_run_jobs: true
#demos_gen_model: granite-3-2-8b-instruct
