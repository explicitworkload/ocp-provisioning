{#
  Milvus as an AI asset vector store, in the shape RHOAI's Gen AI BFF reads.

  The same llama-stack layout the model endpoints use - providers plus
  registered_resources - but under vector_io and vector_stores rather than
  inference and models. remote::milvus is one of the provider types this
  build supports; the others are remote::pgvector, remote::qdrant and
  inline::faiss.

  uri carries a scheme, unlike Attu's MILVUS_URL which does not.

  vector_store_name is what the tab displays. Without it the row renders with
  an empty name, which is how this was first published; metadata.display_name
  is NOT read here, though it is for models.
-#}
providers:
  vector_io:
    - provider_id: {{ milvus_provider_id }}
      provider_type: remote::milvus
      config:
        uri: http://{{ milvus_name }}-milvus.{{ milvus_namespace }}.svc.cluster.local:19530
        # NOTE: this line has NO EFFECT today. Kept only so the intent is
        # visible, and so it starts working if upstream adds the field.
        #
        # The problem it is aimed at is real: MilvusVectorIOConfig declares
        # token as required-but-nullable, so a provider config without it
        # does not merely degrade the vector store, it takes down the whole
        # Gen AI playground. ogx validates every provider at startup,
        # pydantic raises "1 validation error for MilvusVectorIOConfig:
        # token Field required", and the process exits 0 - so the pod sits
        # in CrashLoopBackOff with a clean exit code and nothing points
        # here. It surfaces whenever someone first opens the Gen AI studio,
        # which creates the OGXServer on demand - potentially days after
        # this file was written.
        #
        # But this file is not passed through. The Gen AI BFF (the
        # gen-ai-ui Deployment in redhat-ods-applications,
        # github.com/opendatahub-io/gen-ai) unmarshals it into a typed Go
        # struct - models.VectorStoreConfig is {Key, URI} - and re-emits
        # llama-stack-config from that. Any key with no struct field is
        # silently discarded, and there is no Token field, so no value of
        # token can survive the compile. The ${env.X} substitutions visible
        # in llama-stack-config are BFF-authored boilerplate, not reachable
        # from here.
        #
        # The working fix is one level up: OGXServer.spec.overrideConfig
        # points the playground at a ConfigMap the BFF does not own. Note
        # what that costs - with an override set, NOTHING in this file is
        # read any more, including the registered_resources below. See
        # "Where that setting actually lives on this cluster" in
        # demos/autorag/README.md. Needs an upstream fix to be solved
        # properly.
        token: ""
registered_resources:
  vector_stores:
    - vector_store_id: {{ milvus_vector_store_id }}
      vector_store_name: {{ milvus_vector_store_name }}
      provider_id: {{ milvus_provider_id }}
      embedding_model: {{ milvus_embedding_model }}
      embedding_dimension: {{ milvus_embedding_dimension }}
