{#
  LiteLLM's config.yaml. A template rather than an inline block scalar,
  because the extra-endpoint loop needs for-tags and a block scalar cannot
  hold them: indented, a tag emits its own leading whitespace, which pushed
  litellm_settings four columns in and made it a child of the last model;
  flush left, it terminates the scalar and breaks the task file itself.
-#}
model_list:
  - model_name: qwen3-4b
    litellm_params:
      model: openai/qwen3-4b
      api_base: https://{{ model_name }}-{{ model_namespace }}.{{ ocp_apps_domain }}/v1
      api_key: os.environ/QWEN_API_KEY
      tls_verify: false
    # Chat is LiteLLM's default, so this model worked without it -
    # but it reported mode=None, leaving health checks guessing
    # rather than targeting /v1/chat/completions deliberately.
    model_info:
      mode: chat
{% if litellm_azure_available | bool %}
  - model_name: {{ litellm_azure_model_name }}
    litellm_params:
      model: azure/gpt-4
      litellm_credential_name: {{ litellm_azure_credential_name }}
{% endif %}
  # CPU-served embeddings for OpenRAG, fronted here so RAG and chat
  # share one OpenAI-compatible endpoint. Deployed by the openrag
  # role; LiteLLM resolves the host per request, so this entry is
  # harmless (just unusable) when that role has not run.
  - model_name: {{ litellm_embedding_model_name }}
    litellm_params:
      model: openai/{{ litellm_embedding_model_id }}
      api_base: {{ litellm_embedding_api_base }}
      api_key: none
    # Without mode: embedding LiteLLM assumes chat and sends the
    # health check - and the UI "Test connection" - to
    # /v1/chat/completions. text-embeddings-inference serves only
    # /v1/embeddings and answers 404 on the others, so a perfectly
    # working model reports
    #   NotFoundError: OpenAIException - Error code: 404
    model_info:
      mode: embedding
{% for ep in litellm_usable_extras %}
{% for m in ep.models %}
  - model_name: {{ m }}
    litellm_params:
      model: {{ ep.provider | default('openai') }}/{{ m }}
      api_base: {{ ep.base_url }}
      api_key: os.environ/EXTRA_KEY_{{ ep.name | upper | regex_replace('[^A-Z0-9]', '_') }}
    model_info:
      mode: {{ ep.mode | default('chat') }}
{% endfor %}
{% endfor %}
litellm_settings:
  drop_params: true
general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
  store_model_in_db: true
