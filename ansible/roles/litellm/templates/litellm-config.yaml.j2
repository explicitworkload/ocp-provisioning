{#
  LiteLLM's config.yaml - settings only.

  There is no model_list. Models are registered in LiteLLM's own database by
  tasks/models.yml, which is what makes them visible and editable in the
  LiteLLM UI; a model declared here is shown as "Defined in config" and
  cannot be touched from there. store_model_in_db below is what loads them
  at startup.

  Still a template rather than an inline block scalar: indented, a Jinja tag
  inside a block scalar emits its own leading whitespace, which once pushed
  litellm_settings four columns in and made it a child of the last model;
  flush left, it terminates the scalar and breaks the task file itself.
-#}
litellm_settings:
  drop_params: true
general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
  store_model_in_db: true
  disable_env_credential_login: {{ litellm_disable_env_credential_login | bool | lower }}
