{#
  One AI asset endpoint, as RHOAI's Gen AI playground expects it.

  base_url is LiteLLM, not the upstream the entry declares: the same models
  are registered in LiteLLM's config.yaml, so the playground, OpenRAG, Dev
  Spaces and the Ops Dashboard all reach them through one proxy with one key.
  The upstream URL and its key stay in litellm-secrets.

  A template rather than an inline expression because the models list needs a
  loop, and Jinja has no list comprehension - building it inline failed with
  "expected token ',', got 'for'".

  `item` is the entry from litellm_publishable_endpoints.
-#}
providers:
  inference:
    - provider_id: {{ item.name }}
      provider_type: remote::openai
      config:
        base_url: http://litellm.{{ litellm_namespace }}.svc.cluster.local:4000/v1
        allowed_models:
{% for m in item.models %}
          - {{ m }}
{% endfor %}
        custom_gen_ai:
          api_key:
            secretRef:
              name: gen-ai-key-{{ item.name }}
              key: api_key
registered_resources:
  models:
{% for m in item.models %}
    - provider_id: {{ item.name }}
      model_id: {{ m }}
      model_type: {{ item.model_type | default('llm') }}
      metadata:
        display_name: {{ m }}
{% endfor %}
