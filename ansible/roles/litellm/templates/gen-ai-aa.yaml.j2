{#
  LiteLLM as one AI asset endpoint, the shape RHOAI's Gen AI playground
  expects.

  base_url is LiteLLM's in-cluster service and the key is the openshift-ai
  virtual key, so the playground reaches every model through the same proxy
  the Ops Dashboard, OpenRAG and Dev Spaces/Continue use. Each upstream's own
  URL and key stay in litellm-secrets.

  A template rather than an inline expression because the models list needs a
  loop, and Jinja has no list comprehension - building it inline failed with
  "expected token ',', got 'for'".

  litellm_asset_models is the list decided in tasks/ai_endpoints.yml.
-#}
providers:
  inference:
    - provider_id: {{ litellm_ai_asset_name }}
      provider_type: remote::openai
      config:
        base_url: http://litellm.{{ litellm_namespace }}.svc.cluster.local:4000/v1
        allowed_models:
{% for m in litellm_asset_models %}
          - {{ m }}
{% endfor %}
        custom_gen_ai:
          api_key:
            secretRef:
              name: {{ litellm_ai_asset_key_secret }}
              key: api_key
registered_resources:
  models:
{% for m in litellm_asset_models %}
    - provider_id: {{ litellm_ai_asset_name }}
      model_id: {{ m }}
      model_type: llm
      metadata:
        display_name: {{ m }}
{% endfor %}
