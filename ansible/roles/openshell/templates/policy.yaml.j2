{#
  The gateway-wide base policy, applied to every sandbox it creates.

  Supplied at the gateway rather than baked into the sandbox image, because
  the image is upstream's and the allow-list is ours: the hostnames below
  are this cluster's Service DNS, which upstream could not know. OpenShell
  resolves policy from the global gateway policy, then a saved policy, then
  one embedded in the image, then its own restrictive default - so this is
  the first and broadest of the four.

  network_policies entries are per-binary on purpose. OpenShell identifies
  the calling program from trusted /proc data on the sandbox side, so a
  rule can say "curl may reach LiteLLM" rather than "this sandbox may reach
  LiteLLM". The binaries list below is deliberately broad - an agent shells
  out through whatever it likes - but it is the hook to narrow later.
-#}
version: 1

process:
  # Left unset on purpose. OpenShell's Kubernetes driver reads the
  # namespace's openshift.io/sa.scc.uid-range annotation and renders a
  # numeric non-root identity from that range; pinning a uid here would
  # fight OpenShift's allocator and break the restricted SCC fit.
  {}

landlock:
  # Refuse to start rather than run unenforced. OpenShell needs Landlock
  # ABI 3, which RHCOS carries from OpenShift 4.19 - 4.16 through 4.18 are
  # built without Landlock and fail this probe. If the gateway's sandboxes
  # never leave Pending with a Landlock error, that is this line doing its
  # job on too old a cluster, not a bug.
  fail_if_unsupported: {{ openshell_require_landlock | bool | lower }}

filesystem_policy:
  # The agent's own workspace, and nothing else writable.
  - path: /workspace
    access: read_write
  - path: /tmp
    access: read_write
  # Enough of the image to run. Read-only: an agent that can rewrite
  # /usr/bin can replace the binaries the network policy names.
  - path: /usr
    access: read
  - path: /etc
    access: read
  - path: /lib
    access: read
  - path: /bin
    access: read

network_policies:
{% for d in (openshell_egress_allow + openshell_egress_extra) %}
  - name: allow-{{ d.name }}
    binaries:
      - /usr/bin/curl
      - /usr/bin/git
      - /usr/bin/python3
      - /usr/bin/node
      - /usr/local/bin/omnigent
    destinations:
      - hostname: {{ d.hostname }}
        port: {{ d.port }}
{% endfor %}
