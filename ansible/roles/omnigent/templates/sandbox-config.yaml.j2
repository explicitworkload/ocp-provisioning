{#
  The server's sandbox: section, mounted at OMNIGENT_CONFIG.

  server_url is in-cluster Service DNS and deliberately plain http on port
  80: this is the runner Pod dialling back to the server, pod to pod, and
  routing it out through the Route and back would depend on the proxy for
  traffic that never leaves the cluster - and the proxy would demand an
  OpenShift login the runner does not have.
-#}
sandbox:
  provider: {{ omnigent_sandbox_provider }}
  server_url: http://omnigent.{{ omnigent_namespace }}.svc.cluster.local
{% if omnigent_use_litellm | bool %}
  # Verbatim ~/.omnigent/config.yaml for the agent inside the sandbox,
  # merged before "omnigent host" starts. This is what points the harness
  # at the cluster's own gateway instead of a vendor API, so every model
  # LiteLLM serves is available and no provider key is needed here.
  #
  # api_key_ref resolves INSIDE the runner Pod against the Secret named
  # below, so the key itself never appears in this ConfigMap.
  #
  # A gateway entry groups one or more model FAMILIES, and "default:" is a
  # list of the family scopes this provider is the default for - not a list
  # of agents. The three scopes that matter here:
  #
  #   anthropic  the Messages API surface, consumed by native Claude Code
  #   openai     the Responses/Chat surface, consumed by Codex and opencode
  #   pi         omnigent's own agent, which consumes either family
  #
  # This used to declare only "openai" and "default: [pi]", which is why
  # the model picker offered exactly one model: nothing but pi had a
  # gateway, so Claude Code fell back to the single ANTHROPIC_MODEL env var
  # and every other model LiteLLM serves was invisible. Adding the
  # anthropic family gives Claude Code the gateway too, and the catalog
  # then lists whatever GET <base_url>/v1/models returns.
  host_config:
    providers:
      litellm:
        kind: gateway
        default: [{{ omnigent_gateway_default_families | join(', ') }}]
        {# No /v1 here on purpose. The catalog appends /v1/models when the
           base does not already name a version, and the harness appends
           /v1/messages - a base that already said /v1 builds a path
           LiteLLM does not serve. The openai family below is the opposite
           case and keeps its suffix. -#}
        anthropic:
          base_url: {{ omnigent_anthropic_base_url }}
          api_key_ref: env:LITELLM_API_KEY
          {# Which model a Claude Code session starts on. The picker still
             lists the whole catalog; this is only the pre-selection, and
             it stays on the model with the most testing behind it. -#}
          models:
            default: {{ omnigent_anthropic_model }}
        openai:
          base_url: {{ omnigent_litellm_url }}
          api_key_ref: env:LITELLM_API_KEY
          wire_api: chat
{% endif %}
{% if omnigent_sandbox_provider == 'openshell' %}
  {# The openshell provider takes none of the kubernetes block: OpenShell's
     own driver owns sandbox creation, down to the namespace and the pod's
     security context, which it derives from the namespace's
     openshift.io/sa.scc.uid-range annotation. Setting namespace or
     resources here would be setting them for a provider that is not
     running.

     env is SERVER variable NAMES, not values - the server reads its own
     environment at provision time and copies them in. A name listed and
     not set fails the launch loudly, which is the behaviour you want for
     a credential. -#}
  {# The reaper is the POC's, and it earns its place on a demo cluster:
     sandboxes are Pods with a PVC each, and a session nobody closes keeps
     both. terminate_after_offline_days counts from the last time the
     runner checked in, not from creation, so an idle-but-attached session
     is left alone. -#}
  reaper:
    enabled: {{ omnigent_openshell_reaper | bool | lower }}
    terminate_after_offline_days: {{ omnigent_openshell_reap_after_days }}
    sweep_interval_s: {{ omnigent_openshell_reap_interval }}
  openshell:
{% if omnigent_openshell_providers | length > 0 %}
    {# Gateway-side credentials attached to every sandbox this server
       creates. Without at least one the sandbox is denied egress to the
       model gateway entirely - OpenShell is deny-by-default and the
       image's baked policy says nothing about this cluster's LiteLLM.

       This key only exists in the aicatalyst fork of the server; upstream
       ignores nothing and instead rejects the config outright. See
       omnigent_image in defaults/main.yml. -#}
    providers:
{% for p in omnigent_openshell_providers %}
      - {{ p }}
{% endfor %}
{% endif %}
    env:
{% for e in omnigent_openshell_env %}
      - {{ e }}
{% endfor %}
{% if omnigent_openshell_gateway | length > 0 %}
    cluster: {{ omnigent_openshell_gateway }}
{% endif %}
{% if omnigent_sandbox_host_image | length > 0 %}
    image: {{ omnigent_sandbox_host_image }}
{% endif %}
{% else %}
  kubernetes:
    namespace: {{ omnigent_sandbox_namespace }}
    secret_name: omnigent-creds
    service_account: omnigent-runner
{% if omnigent_sandbox_host_image | length > 0 %}
    image: {{ omnigent_sandbox_host_image }}
{% endif %}
    {# The ordinary Kubernetes shape, requests/limits, not flat
       cpu_request/memory_limit keys. The server validates this block
       strictly and refuses to start on an unknown key:

         ValueError: server config 'sandbox.kubernetes.resources' has an
         unknown key 'cpu_request' (expected 'requests' or 'limits')

       which leaves the pod Running but never Ready, so the Service has no
       endpoints and the Route answers 503. -#}
    resources:
      requests:
        cpu: "{{ omnigent_sandbox_cpu_request }}"
        memory: "{{ omnigent_sandbox_memory_request }}"
      limits:
        cpu: "{{ omnigent_sandbox_cpu_limit }}"
        memory: "{{ omnigent_sandbox_memory_limit }}"
{% endif %}
